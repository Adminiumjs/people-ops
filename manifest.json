{
  "manifestVersion": 1,
  "key": "hr",
  "name": "People Ops",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.hr.desc",
    "fallback": "A people desk with leave balances, approvals that route themselves, a team calendar and onboarding checklists — backed by your own database."
  },
  "categories": [
    "internal-tools"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": []
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "departments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          }
        ]
      },
      {
        "ref": "positions",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "department_id",
            "type": "fk",
            "references": "departments"
          },
          {
            "ref": "title",
            "type": "text"
          }
        ]
      },
      {
        "ref": "employees",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "avatar",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "position_id",
            "type": "fk",
            "references": "positions"
          },
          {
            "ref": "manager_id",
            "type": "fk",
            "references": "employees"
          },
          {
            "ref": "buddy_id",
            "type": "fk",
            "references": "employees"
          },
          {
            "ref": "started_on",
            "type": "date"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "active",
              "on_leave",
              "left"
            ]
          },
          {
            "ref": "city",
            "type": "text"
          }
        ]
      },
      {
        "ref": "leave_types",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "short_name",
            "type": "text"
          },
          {
            "ref": "annual_days",
            "type": "decimal"
          },
          {
            "ref": "accrual",
            "type": "enum",
            "enum": [
              "upfront",
              "monthly"
            ]
          },
          {
            "ref": "per_month",
            "type": "decimal"
          },
          {
            "ref": "color",
            "type": "text"
          }
        ]
      },
      {
        "ref": "leave_requests",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "employee_id",
            "type": "fk",
            "references": "employees"
          },
          {
            "ref": "type_id",
            "type": "fk",
            "references": "leave_types"
          },
          {
            "ref": "starts_on",
            "type": "date"
          },
          {
            "ref": "ends_on",
            "type": "date"
          },
          {
            "ref": "working_days",
            "type": "int"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "pending",
              "manager_approved",
              "approved",
              "rejected",
              "cancelled"
            ]
          },
          {
            "ref": "decided_by",
            "type": "fk",
            "references": "employees"
          },
          {
            "ref": "decided_at",
            "type": "timestamptz"
          },
          {
            "ref": "note",
            "type": "text"
          },
          {
            "ref": "decision_note",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "holidays",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "on_date",
            "type": "date"
          }
        ]
      },
      {
        "ref": "onboarding_templates",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          }
        ]
      },
      {
        "ref": "onboarding_tasks",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "template_id",
            "type": "fk",
            "references": "onboarding_templates"
          },
          {
            "ref": "employee_id",
            "type": "fk",
            "references": "employees"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "phase",
            "type": "enum",
            "enum": [
              "before",
              "day_1",
              "week_1",
              "month_1"
            ]
          },
          {
            "ref": "due_offset_days",
            "type": "int"
          },
          {
            "ref": "done",
            "type": "bool"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "hr-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.hr.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:hr",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "hr-people",
      "template": "page-directory",
      "title": {
        "key": "mft.hr.page.people",
        "fallback": "People"
      },
      "nav": {
        "group": "manifest:hr",
        "icon": "users",
        "order": 2
      }
    },
    {
      "ref": "hr-leave",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.hr.page.leave",
        "fallback": "Approvals"
      },
      "nav": {
        "group": "manifest:hr",
        "icon": "inbox",
        "order": 3
      }
    },
    {
      "ref": "hr-calendar",
      "template": "page-calendar",
      "title": {
        "key": "mft.hr.page.calendar",
        "fallback": "Team calendar"
      },
      "nav": {
        "group": "manifest:hr",
        "icon": "calendar-days",
        "order": 4
      }
    },
    {
      "ref": "hr-onboarding",
      "template": "page-crud",
      "title": {
        "key": "mft.hr.page.onboarding",
        "fallback": "Onboarding"
      },
      "nav": {
        "group": "manifest:hr",
        "icon": "clipboard-check",
        "order": 5
      }
    },
    {
      "ref": "hr-policies",
      "template": "page-crud",
      "title": {
        "key": "mft.hr.page.policies",
        "fallback": "Leave policy"
      },
      "nav": {
        "group": "manifest:hr",
        "icon": "shield-check",
        "order": 6
      }
    }
  ],
  "capabilities": [
    "email-delivery",
    "file-storage"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "spa",
      "entry": "index.html",
      "routes": {
        "home": "/",
        "request": "/",
        "directory": "/"
      }
    }
  ]
}
